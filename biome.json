{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!src/resources/custom.css"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/tiptap-ui/**",
        "src/components/tiptap-ui-primitive/**",
        "src/components/tiptap-node/**",
        "src/components/tiptap-icons/**",
        "src/components/tiptap-extension/**",
        "src/components/tiptap-templates/**",
        "src/components/ui/**",
        "src/lib/tiptap-utils.ts",
        "src/hooks/use-*.ts",
        "src/components/icons/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "noStaticElementInteractions": "off",
            "useSemanticElements": "off",
            "useButtonType": "off"
          },
          "complexity": {
            "useOptionalChain": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useImportType": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "useIterableCallbackReturn": "off",
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["src/resources/*.css", "src/**/*.scss"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
