# NextAuth / Google OAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MongoDB — required for publishing from /admin on a deployed site (MDX writes don't persist on Netlify)
USE_MONGODB=true
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
MONGODB_DB=derpx06

# Default storage for new articles: 'mdx' or 'mongodb'
DEFAULT_ARTICLE_STORAGE=mongodb

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# Admin: comma-separated Google account emails allowed to use /admin and /blog/editor
ADMIN_EMAILS=
# Newsletter form in the footer (Buttondown username). Leave empty to show "coming soon".
NEXT_PUBLIC_BUTTONDOWN_USER=
