# ============================================================================
# derpx06-blog — environment
#
# Local:  copy to .env.local and fill in.
# Vercel: add the REQUIRED vars under Settings → Environment Variables
#         (Production + Preview). Nothing here is exposed to the browser —
#         no NEXT_PUBLIC_ prefixes, so every value stays server-side.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED

# Canonical origin for meta tags, JSON-LD, sitemap.xml and RSS. No trailing
# slash. On Vercel this falls back to the project's production domain, but set
# it explicitly once you have a custom one.
SITE_URL=https://derpx06.online

# All content — articles, explainers, lessons, courses — plus reader accounts,
# sessions and per-reader state live in MongoDB. There is no local fallback:
# if this is unreachable during `next build`, the build fails rather than
# deploying an empty site.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
MONGODB_DB=derpx06

# On Atlas, allow the build to connect: Network Access → 0.0.0.0/0
# (Vercel's build and serverless IPs are not fixed.)

# Password for the routes listed in `protectedRoutes` (src/resources/route-policy.ts).
# Unrelated to reader accounts, which use email + password stored in MongoDB.
# The gate is enforced server-side in src/proxy.ts, so the protected page's HTML
# is never rendered for a visitor without the cookie.
PAGE_ACCESS_PASSWORD=change-me

# Signs the page-access cookie. Without it the password itself is used as the
# key, which works but means rotating the password invalidates nothing else.
# Any long random string: `openssl rand -base64 32`.
PAGE_ACCESS_SECRET=

# Who can use the admin CMS at /admin, comma-separated. These are ordinary
# reader accounts that this list promotes — there is no role in the database, so
# admin rights change only by changing this value and redeploying.
#
# Public signup refuses any address listed here, so nobody can claim one by
# registering it first. Create the account with:
#   npm run admin:create -- you@example.com
ADMIN_EMAILS=

# ---------------------------------------------------------------- OPTIONAL

# Collection names. Defaults shown; set only if yours differ.
MONGODB_CONTENT_COLLECTION=content
MONGODB_COURSE_COLLECTION=courses

# Image uploads, from the admin editor and the legacy one. With these set,
# uploads go to Cloudinary; without them they are written to public/uploads.
#
# REQUIRED IN PRODUCTION once the admin CMS is in use: a serverless filesystem
# is ephemeral, so the disk fallback would accept an image and lose it. It
# therefore refuses to run when NODE_ENV=production rather than failing quietly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gates the localhost-only endpoints: /api/upload (the admin editor's image
# upload) and /api/og/{proxy,fetch}. They are allowed on a dev machine with no
# configuration; in a production build they additionally require this flag,
# because a Host header alone is not something to stake an unauthenticated
# write endpoint on. Leave it unset in Vercel.
# (The legacy /blog/editor and /simple editors this used to gate are deleted.)
ENABLE_LOCAL_EDITOR=
