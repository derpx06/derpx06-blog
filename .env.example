# ============================================================================
# derpx06-blog — environment
#
# Local:  copy to .env.local and fill in.
# Vercel: add each REQUIRED var under Settings → Environment Variables
#         (Production + Preview). Nothing here is exposed to the browser —
#         no NEXT_PUBLIC_ prefixes, so every value stays server-side.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED
# Canonical origin, used for meta tags, JSON-LD, sitemap.xml and RSS.
# No trailing slash. On Vercel this falls back to the project's production
# domain, but set it explicitly once you have a custom domain.
SITE_URL=https://derpx06.online

# MongoDB holds the articles, courses, reader accounts, sessions and
# per-reader state. Without it the site builds but has no content.
USE_MONGODB=true
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
MONGODB_DB=derpx06

# On Atlas, allow Vercel to connect: Network Access → 0.0.0.0/0
# (Vercel's build and serverless IPs are not fixed.)

# ---------------------------------------------------------------- OPTIONAL
# Collection names. Defaults shown; only set these if yours differ.
MONGODB_CONTENT_COLLECTION=content
MONGODB_COURSE_COLLECTION=courses

# Where content is read from: local (MDX files) | hybrid | mongodb
# Unset + USE_MONGODB=true behaves as "hybrid".
CONTENT_STORAGE=mongodb
COURSE_STORAGE=hybrid

# Where the editor writes new articles: mongodb | mdx
# Must be "mongodb" on Vercel — the filesystem there is read-only.
DEFAULT_ARTICLE_STORAGE=mongodb

# Password for routes listed in `protectedRoutes` (src/resources/site.config.ts).
# Unrelated to reader accounts, which use email + password in MongoDB.
PAGE_ACCESS_PASSWORD=change-me

# Editor image uploads. With these set, uploads go to Cloudinary; without
# them they are written to public/uploads, which only works locally.
# The editor is localhost-only, so these are not needed for a Vercel deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
