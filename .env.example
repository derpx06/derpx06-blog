# NextAuth / Google OAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MongoDB (optional)
USE_MONGODB=false
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
MONGODB_DB=derpx06

# Default storage for new articles: 'mdx' or 'mongodb'
DEFAULT_ARTICLE_STORAGE=mdx

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password
