# ============================================================================
# derpx06-blog — environment
#
# Local:  copy to .env.local and fill in.
# Vercel: add the REQUIRED vars under Settings → Environment Variables
#         (Production + Preview). Nothing here is exposed to the browser —
#         no NEXT_PUBLIC_ prefixes, so every value stays server-side.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED

# Canonical origin for meta tags, JSON-LD, sitemap.xml and RSS. No trailing
# slash. On Vercel this falls back to the project's production domain, but set
# it explicitly once you have a custom one.
SITE_URL=https://derpx06.online

# All content — articles, explainers, lessons, courses — plus reader accounts,
# sessions and per-reader state live in MongoDB. There is no local fallback:
# if this is unreachable during `next build`, the build fails rather than
# deploying an empty site.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
MONGODB_DB=derpx06

# On Atlas, allow the build to connect: Network Access → 0.0.0.0/0
# (Vercel's build and serverless IPs are not fixed.)

# Password for the routes listed in `protectedRoutes` (src/resources/site.config.ts).
# Unrelated to reader accounts, which use email + password stored in MongoDB.
PAGE_ACCESS_PASSWORD=change-me

# ---------------------------------------------------------------- OPTIONAL

# Collection names. Defaults shown; set only if yours differ.
MONGODB_CONTENT_COLLECTION=content
MONGODB_COURSE_COLLECTION=courses

# Editor image uploads. With these set, uploads go to Cloudinary; without them
# they are written to public/uploads, which only works locally. The editor is
# localhost-only, so these are not needed for a Vercel deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
